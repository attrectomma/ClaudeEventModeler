<!-- TEST FIXTURE, not a domain model. resolved.drawio with one planted defect per newer rule.
     Expected findings, exactly:
       ERROR completeness/undisplayable-data   Cart Page displays discount, no View supplies it
       ERROR gwt/gwt-needs-when                gwt-add-item names no command
       ERROR gwt/gwt-unknown-event             gwt-remove-added-item given="NeverHappened"
       ERROR gwt/gwt-then-not-emitted          gwt-remove-absent-item expects ItemAdded from RemoveItem
       WARN  completeness/screen-declares-nothing   Summary Page is fed a View but declares no displays
       INFO  completeness/clock-filled          CartCleared.clearedAt -->
<mxfile host="Electron" agent="Claude" type="device">
  <diagram name="Fixture - gaps" id="fixture-gaps">
    <mxGraphModel dx="1420" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1100" math="0" shadow="0">
