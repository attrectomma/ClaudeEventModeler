<!-- TEST FIXTURE, not a domain model. The resolution of unsourced.drawio, per Fig. 12.14:
     the itemId's real source is the earlier "Item Added" event, reached through a read model that
     the Cart Page displays. Expected: zero errors. If this ever reports one, the checker is wrong. -->
<mxfile host="Electron" agent="Claude" type="device">
  <diagram name="Fixture - resolved" id="fixture-resolved">
    <mxGraphModel dx="1420" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lane-ui" value="UI / Wireframes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#777777;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lane-cmd" value="Commands / Views / Automation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#777777;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lane-evt" value="Event Stream" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#777777;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1320" height="180" as="geometry" />
        </mxCell>
        <object id="slice-add-item" label="add-item&#10;state-change · ready" em="group" slice="add-item" pattern="state-change" status="ready">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;fontColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
            <mxGeometry x="80" y="0" width="220" height="600" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-cart-items" label="cart-items&#10;state-view · ready" em="group" slice="cart-items" pattern="state-view" status="ready">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;fontColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
            <mxGeometry x="400" y="0" width="220" height="600" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-remove-item" label="remove-item&#10;state-change · ready" em="group" slice="remove-item" pattern="state-change" status="ready">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;fontColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
            <mxGeometry x="720" y="0" width="220" height="600" as="geometry" />
          </mxCell>
        </object>

        <object id="ui-catalog" label="Catalog Page" em="screen" screen="catalog" slice="add-item" inputs="itemId:Guid, name:string">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="100" y="90" width="180" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="cmd-add-item" label="AddItem" em="command" slice="add-item" aggregate="Cart" fields="itemId:Guid, name:string">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="100" y="290" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-item-added" label="ItemAdded" em="event" slice="add-item" aggregate="Cart" fields="itemId:Guid, name:string">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="100" y="470" width="180" height="60" as="geometry" />
          </mxCell>
        </object>

        <object id="rm-cart-items" label="CartItems" em="readmodel" slice="cart-items" fields="itemId:Guid, name:string">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="420" y="290" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="ui-cart" label="Cart Page" em="screen" screen="cart" slice="cart-items" displays="itemId:Guid, name:string">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="420" y="90" width="180" height="90" as="geometry" />
          </mxCell>
        </object>

        <object id="cmd-remove-item" label="RemoveItem" em="command" slice="remove-item" aggregate="Cart" fields="itemId:Guid">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="740" y="290" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-item-removed" label="ItemRemoved" em="event" slice="remove-item" aggregate="Cart" fields="itemId:Guid">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="740" y="470" width="180" height="60" as="geometry" />
          </mxCell>
        </object>

        <mxCell id="lane-gwt" value="Given / When / Then" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1320" height="440" as="geometry" />
        </mxCell>
        <object id="gwt-add-item" label="GIVEN nothing&#10;WHEN AddItem&#10;THEN ItemAdded" em="gwt" slice="add-item" rule="an item can be added to an empty cart" when="AddItem" then="ItemAdded">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="100" y="650" width="300" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-remove-added-item" label="GIVEN ItemAdded&#10;WHEN RemoveItem&#10;THEN ItemRemoved" em="gwt" slice="remove-item" rule="an item already in the cart can be removed" given="ItemAdded" when="RemoveItem" then="ItemRemoved">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="650" width="300" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-remove-absent-item" label="GIVEN nothing&#10;WHEN RemoveItem&#10;THEN error: ItemNotInCart" em="gwt" slice="remove-item" rule="removing an item that is not in the cart is rejected" when="RemoveItem" then="error: ItemNotInCart">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="770" width="300" height="100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="ui-catalog" target="cmd-add-item">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="cmd-add-item" target="evt-item-added">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-item-added" target="rm-cart-items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="rm-cart-items" target="ui-cart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;exitX=0.75;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ui-cart" target="cmd-remove-item">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="cmd-remove-item" target="evt-item-removed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
