            <mxGeometry x="80" y="140" width="220" height="1040" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-close-campaign" label="close-campaign&#10;command · ready" em="group" slice="close-campaign" pattern="command" status="ready" owners="backend-agent, frontend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="400" y="140" width="220" height="1040" as="geometry" />
