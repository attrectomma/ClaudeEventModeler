          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cmd-close-campaign--evt-campaign-closed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd-close-campaign" target="evt-campaign-closed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-scr-compose--cmd-queue-message" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="scr-compose" target="cmd-queue-message">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cmd-queue-message--evt-message-queued" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd-queue-message" target="evt-message-queued">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-scr-deliveries--cmd-record-outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="scr-deliveries" target="cmd-record-outcome">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cmd-record-outcome--evt-message-delivered" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd-record-outcome" target="evt-message-delivered">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cmd-record-outcome--evt-message-bounced" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd-record-outcome" target="evt-message-bounced">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="630" />
              <mxPoint x="1250" y="1175" />
              <mxPoint x="1150" y="1175" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-campaign-opened--rm-campaign-dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-campaign-opened" target="rm-campaign-dashboard">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="736" />
              <mxPoint x="2047" y="736" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-campaign-closed--rm-campaign-dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-campaign-closed" target="rm-campaign-dashboard">
          <mxGeometry relative="1" as="geometry">
