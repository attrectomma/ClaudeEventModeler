        <mxCell id="e-evt-message-queued--rm-sender-monthly" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-message-queued" target="rm-sender-monthly">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="848" y="776" />
              <mxPoint x="2430" y="776" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-message-queued--rm-message-metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-message-queued" target="rm-message-metrics">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="875" y="784" />
              <mxPoint x="2705" y="784" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-message-delivered--rm-message-status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-message-delivered" target="rm-message-status">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1105" y="792" />
              <mxPoint x="1470" y="792" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-message-delivered--rm-campaign-dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.35;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-message-delivered" target="rm-campaign-dashboard">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1123" y="800" />
              <mxPoint x="2146" y="800" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-message-delivered--rm-message-metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-message-delivered" target="rm-message-metrics">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1195" y="808" />
              <mxPoint x="2750" y="808" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-message-bounced--rm-message-status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-message-bounced" target="rm-message-status">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1280" y="1125" />
              <mxPoint x="1280" y="816" />
              <mxPoint x="1515" y="816" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-message-bounced--rm-campaign-dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-message-bounced" target="rm-campaign-dashboard">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="1140" />
              <mxPoint x="1300" y="824" />
              <mxPoint x="2173" y="824" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-message-bounced--rm-message-metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-message-bounced" target="rm-message-metrics">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1320" y="1110" />
              <mxPoint x="1320" y="832" />
              <mxPoint x="2795" y="832" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object id="gwt-open-campaign-1" label="a campaign can be opened&#10;&#10;GIVEN —&#10;WHEN OpenCampaign&#10;THEN CampaignOpened" em="gwt" slice="open-campaign" rule="a campaign can be opened" when="OpenCampaign" then="CampaignOpened">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="100" y="1330" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-open-campaign-2" label="a campaign with no name is refused&#10;&#10;GIVEN —&#10;WHEN OpenCampaign&#10;THEN error: NameRequired" em="gwt" slice="open-campaign" rule="a campaign with no name is refused" when="OpenCampaign" then="error: NameRequired" enforce="periphery">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="100" y="1470" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-close-campaign-1" label="an open campaign can be closed&#10;&#10;GIVEN CampaignOpened&#10;WHEN CloseCampaign&#10;THEN CampaignClosed" em="gwt" slice="close-campaign" rule="an open campaign can be closed" given="CampaignOpened" when="CloseCampaign" then="CampaignClosed">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="420" y="1330" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-close-campaign-2" label="closing a closed campaign is refused&#10;&#10;GIVEN CampaignOpened, CampaignClosed&#10;WHEN CloseCampaign&#10;THEN error: AlreadyClosed" em="gwt" slice="close-campaign" rule="closing a closed campaign is refused" given="CampaignOpened, CampaignClosed" when="CloseCampaign" then="error: AlreadyClosed" enforce="aggregate">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="420" y="1470" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-queue-message-1" label="a message can be queued to an open campaign&#10;&#10;GIVEN CampaignOpened&#10;WHEN QueueMessage&#10;THEN MessageQueued" em="gwt" slice="queue-message" rule="a message can be queued to an open campaign" given="CampaignOpened" when="QueueMessage" then="MessageQueued">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="1330" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-queue-message-2" label="a message with no recipients is refused&#10;&#10;GIVEN —&#10;WHEN QueueMessage&#10;THEN error: RecipientsRequired" em="gwt" slice="queue-message" rule="a message with no recipients is refused" when="QueueMessage" then="error: RecipientsRequired" enforce="periphery">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="1470" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-queue-message-3" label="a message cannot be queued to a closed campaign&#10;&#10;GIVEN CampaignOpened, CampaignClosed&#10;WHEN QueueMessage&#10;THEN error: CampaignNotOpen" em="gwt" slice="queue-message" rule="a message cannot be queued to a closed campaign" given="CampaignOpened, CampaignClosed" when="QueueMessage" then="error: CampaignNotOpen" enforce="aggregate" note="The cross-stream rule. It reads the Campaign stream and writes the Message stream, which is a READ plus one write and not two writes — the distinction command-crosses-swimlane exists to protect.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="1610" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-record-outcome-1" label="a delivery is recorded&#10;&#10;GIVEN MessageQueued&#10;WHEN RecordOutcome&#10;THEN MessageDelivered" em="gwt" slice="record-outcome" rule="a delivery is recorded" given="MessageQueued" when="RecordOutcome" then="MessageDelivered">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1330" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-record-outcome-2" label="a bounce is recorded&#10;&#10;GIVEN MessageQueued&#10;WHEN RecordOutcome&#10;THEN MessageBounced" em="gwt" slice="record-outcome" rule="a bounce is recorded" given="MessageQueued" when="RecordOutcome" then="MessageBounced" note="Same command, same given, a different event — the outcome field decides. This is why one command emitting two events is the right shape here.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1470" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-record-outcome-3" label="an outcome for a recipient not on the message is refused&#10;&#10;GIVEN MessageQueued&#10;WHEN RecordOutcome&#10;THEN error: NotARecipient" em="gwt" slice="record-outcome" rule="an outcome for a recipient not on the message is refused" given="MessageQueued" when="RecordOutcome" then="error: NotARecipient" enforce="aggregate" note="Needs the folded recipients list, so it cannot be a validator rule. It is also what keeps DeliveryLog honest: a delivery for a recipient with no log row would be unreachable from the view.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1610" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-message-status-1" label="a queued message starts with nothing delivered&#10;&#10;GIVEN MessageQueued (2 recipients)&#10;THEN MessageStatus shows 2 expected, 0 delivered, 0 bounced, status Queued" em="gwt" slice="message-status" rule="a queued message starts with nothing delivered" given="MessageQueued" then="MessageStatus(recipientCount=2, delivered=0, bounced=0, status=Queued)" note="A GIVEN/THEN, not a GWT: a read model only ever reads events that already exist, so there is no command to be the WHEN. Understanding EventSourcing ch.3 — &quot;you typically do not use GWTs but GTs (Given - Then)&quot;.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="1330" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-message-status-2" label="a delivery and a bounce are counted separately&#10;&#10;GIVEN MessageQueued, MessageDelivered, MessageBounced&#10;THEN MessageStatus shows 1 delivered and 1 bounced" em="gwt" slice="message-status" rule="a delivery and a bounce are counted separately" given="MessageQueued, MessageDelivered, MessageBounced" then="MessageStatus(delivered=1, bounced=1)" note="Two different outcome events land on ONE row. A fold that treated them alike would pass any test that only ever sent one of them.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="1470" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-message-status-3" label="status is derived from the counts, not carried&#10;&#10;GIVEN MessageQueued (1 recipient), MessageDelivered&#10;THEN MessageStatus status reads as complete" em="gwt" slice="message-status" rule="status is derived from the counts and not carried" given="MessageQueued, MessageDelivered" then="MessageStatus(status=Complete)" note="status= is a derived= field: no event carries it. The GT is the only place its rule is written down.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="1610" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-sender-monthly-1" label="one sender's month rolls up across messages&#10;&#10;GIVEN MessageQueued (2 recipients), MessageQueued (1 recipient, same sender and month)&#10;THEN SenderMonthly shows ONE row: 2 messages, 3 recipients" em="gwt" slice="sender-monthly" rule="one sender's month rolls up across messages" given="MessageQueued, MessageQueued" then="SenderMonthly(messages=2, recipients=3, month=$SeededMonth)" note="A rollup over MANY streams of one type — two messages, one row. This is the recipe this slice exists to demonstrate, and until now nothing asserted it.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2340" y="1330" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-sender-monthly-2" label="two senders are two rows&#10;&#10;GIVEN MessageQueued, MessageQueued (different senders)&#10;THEN SenderMonthly shows TWO rows" em="gwt" slice="sender-monthly" rule="two senders are two rows" given="MessageQueued, MessageQueued" then="SenderMonthly" note="identity=&quot;senderId, month&quot; made executable. A grouping keyed on the wrong field passes the previous GT and fails this one.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2340" y="1470" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-sender-monthly-3" label="an outcome does not touch the monthly rollup&#10;&#10;GIVEN MessageQueued, MessageDelivered&#10;THEN SenderMonthly is unchanged: 1 message" em="gwt" slice="sender-monthly" rule="an outcome does not touch the monthly rollup" given="MessageQueued, MessageDelivered" then="SenderMonthly" note="What the view IGNORES. Only MessageQueued feeds it — the drawing already says so, and this is what makes that assertable.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2340" y="1610" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-message-metrics-1" label="metrics start at zero for a queued message&#10;&#10;GIVEN MessageQueued (2 recipients)&#10;THEN MessageMetrics shows 2 expected, 0 delivered, 0 bounced" em="gwt" slice="message-metrics" rule="metrics start at zero for a queued message" given="MessageQueued" then="MessageMetrics(recipientCount=2, delivered=0, bounced=0)" note="A GIVEN/THEN, not a GWT: a read model only ever reads events that already exist, so there is no command to be the WHEN. Understanding EventSourcing ch.3 — &quot;you typically do not use GWTs but GTs (Given - Then)&quot;.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2660" y="1330" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-message-metrics-2" label="outcomes accumulate onto the metrics&#10;&#10;GIVEN MessageQueued, MessageDelivered, MessageBounced&#10;THEN MessageMetrics shows 1 delivered, 1 bounced" em="gwt" slice="message-metrics" rule="outcomes accumulate onto the message's metrics" given="MessageQueued, MessageDelivered, MessageBounced" then="MessageMetrics(delivered=1, bounced=1)" note="Same events as MessageStatus, a different row shape — which is the whole point of having both in one model.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2660" y="1470" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-delivery-log-1" label="one queued message becomes one row per recipient&#10;&#10;GIVEN MessageQueued (3 recipients)&#10;THEN DeliveryLog shows 3 rows, one per recipient, the first a@example.com" em="gwt" slice="delivery-log" rule="one queued message becomes one row per recipient" given="MessageQueued" then="DeliveryLog(recipient=a@example.com)" note="The FAN-OUT recipe made executable: one event, several rows. identity=&quot;messageId, recipient&quot; says a row is a pairing, and this is the only place that claim is checked.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1330" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-delivery-log-2" label="the same recipient on two messages is two rows&#10;&#10;GIVEN MessageQueued, MessageQueued (same recipient)&#10;THEN DeliveryLog shows 2 rows" em="gwt" slice="delivery-log" rule="the same recipient on two messages is two rows" given="MessageQueued, MessageQueued" then="DeliveryLog" note="A row is keyed by the PAIRING, not by the recipient. A projection keyed on recipient alone passes the first GT and collapses here.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1470" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-delivery-log-3" label="an outcome does not add a log row&#10;&#10;GIVEN MessageQueued (1 recipient), MessageDelivered&#10;THEN DeliveryLog still shows 1 row" em="gwt" slice="delivery-log" rule="an outcome does not add a log row" given="MessageQueued, MessageDelivered" then="DeliveryLog" note="What the view ignores: only MessageQueued feeds it. Without this, a fold that also reacted to outcomes would double the rows and no test would say so.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1610" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-campaign-dashboard-1" label="an opened campaign appears with nothing sent&#10;&#10;GIVEN CampaignOpened&#10;THEN CampaignDashboard shows it, 0 queued" em="gwt" slice="campaign-dashboard" rule="an opened campaign appears with nothing sent" given="CampaignOpened" then="CampaignDashboard(status=Open, queued=0, delivered=0, bounced=0)" note="A GIVEN/THEN — no WHEN, because a read model only reads events that already exist.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2020" y="1330" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-campaign-dashboard-2" label="messages from another stream roll up onto the campaign&#10;&#10;GIVEN CampaignOpened, MessageQueued, MessageDelivered&#10;THEN CampaignDashboard shows 1 queued, 1 delivered" em="gwt" slice="campaign-dashboard" rule="messages from another stream roll up onto the campaign" given="CampaignOpened, MessageQueued, MessageDelivered" then="CampaignDashboard(queued=1, delivered=1, bounced=0)" note="THE reason this view is multi-stream: the Campaign stream and the Message stream land on ONE row, joined on campaignId. Nothing else in this model asserts a cross-stream grouping.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2020" y="1470" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-campaign-dashboard-3" label="closing changes the status and nothing else&#10;&#10;GIVEN CampaignOpened, MessageQueued, CampaignClosed&#10;THEN CampaignDashboard is closed and STILL shows 1 queued" em="gwt" slice="campaign-dashboard" rule="closing a campaign changes its status and nothing else" given="CampaignOpened, MessageQueued, CampaignClosed" then="CampaignDashboard(status=Closed, queued=1)" note="A revise, not a rebuild: the counts accumulated from the OTHER stream must survive an event from this one. A fold that rebuilt the row from CampaignClosed would zero them silently.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2020" y="1610" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="journey-campaign-lifecycle" label="a campaign opened, a message queued, a delivery recorded" em="journey" journey="campaign-lifecycle" slices="open-campaign, queue-message, record-outcome" then="CampaignDashboard(status=Open, queued=1, delivered=1, bounced=0)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6eef7;strokeColor=#6c8ebf;dashed=1;verticalAlign=middle;align=left;spacingLeft=12;fontStyle=1;fontColor=#3f5f8f;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="80" y="1800" width="1180" height="70" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
