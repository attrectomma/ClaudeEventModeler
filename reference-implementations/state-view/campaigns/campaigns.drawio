<mxfile host="Electron" agent="Claude" type="device">
  <diagram name="campaigns" id="context">
    <mxGraphModel dx="1420" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2940" pageHeight="1910" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object id="model-campaigns" label="Campaigns&#10;campaigns · context" em="model" context="campaigns" system="campaigns" note="A reference model for the VIEW pattern, not a domain. Five view slices over TWO stream types, so that Marten's read-model recipes can be compared against ONE model — the point being that Event(s) -> View does not choose between them. Every green box here is a legitimate SingleStreamProjection, EventProjection, MultiStreamProjection, FlatTableProjection or live fold; which one is right is decided by identity=, not by the drawing.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
            <mxGeometry x="40" y="30" width="360" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-ui" label="UI / Wireframes — frontend-agent" em="lane" owner="frontend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="160" width="2840" height="390" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-cmd" label="Commands / Views / Automation — backend-agent" em="lane" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="550" width="2840" height="180" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-evt" label="Event Stream — backend-agent" em="lane" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="870" width="2840" height="310" as="geometry" />
          </mxCell>
        </object>
        <object id="swim-campaign" label="Campaign stream — one stream per campaign" em="lane" streams="Campaign" identity="campaignId">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#dddddd;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=2;fontColor=#999999;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="40" y="895" width="2840" height="95" as="geometry" />
          </mxCell>
        </object>
        <object id="swim-message" label="Message stream — one stream per message" em="lane" streams="Message" identity="messageId" note="A SECOND stream type is the whole reason this model exists: a multi-stream projection spanning two of them is not the same problem as one spanning many streams of one type, and only a model with both can show the difference.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#dddddd;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=2;fontColor=#999999;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="40" y="1000" width="2840" height="170" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-gwt" label="Given / When / Then — one cell per business rule, stacked under its slice" em="lane">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="1300" width="2840" height="460" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-open-campaign" label="open-campaign&#10;state-change · ready" em="group" slice="open-campaign" pattern="state-change" status="ready" owners="backend-agent, frontend-agent">
