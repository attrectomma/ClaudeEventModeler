            <mxGeometry x="80" y="140" width="220" height="1040" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-close-campaign" label="close-campaign&#10;state-change · ready" em="group" slice="close-campaign" pattern="state-change" status="ready" owners="backend-agent, frontend-agent">
