        <object id="slice-queue-message" label="queue-message&#10;command · ready" em="group" slice="queue-message" pattern="command" status="ready" owners="backend-agent, frontend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="720" y="140" width="220" height="1040" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-record-outcome" label="record-outcome&#10;command · ready" em="group" slice="record-outcome" pattern="command" status="ready" owners="backend-agent, frontend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="1040" y="140" width="220" height="1040" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-message-status" label="message-status&#10;view · ready" em="group" slice="message-status" pattern="view" status="ready" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="1360" y="140" width="220" height="1040" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-delivery-log" label="delivery-log&#10;view · ready" em="group" slice="delivery-log" pattern="view" status="ready" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="1680" y="140" width="220" height="1040" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-campaign-dashboard" label="campaign-dashboard&#10;view · ready" em="group" slice="campaign-dashboard" pattern="view" status="ready" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="2000" y="140" width="220" height="1040" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-sender-monthly" label="sender-monthly&#10;view · ready" em="group" slice="sender-monthly" pattern="view" status="ready" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="2320" y="140" width="220" height="1040" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-message-metrics" label="message-metrics&#10;view · ready" em="group" slice="message-metrics" pattern="view" status="ready" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="2640" y="140" width="220" height="1040" as="geometry" />
          </mxCell>
        </object>
        <object id="scr-campaigns-open" label="Campaigns" em="screen" slice="open-campaign" screen="campaigns" inputs="name:string" note="The same screen appears in two slices under one slug. displays= must agree across them and inputs= may differ — which is the whole point: opening needs a name typed, closing needs a campaign picked.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="100" y="200" width="180" height="300" as="geometry" />
          </mxCell>
        </object>
        <object id="scr-campaigns-close" label="Campaigns" em="screen" slice="close-campaign" screen="campaigns" inputs="campaignId:Guid" note="Second cell of the campaigns screen. No displays= on either cell, so no View feeds this screen — deliberately: this model exists to compare read-model IMPLEMENTATIONS, and a screen would drag in styling and a frontend port that add nothing to that comparison.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="420" y="200" width="180" height="300" as="geometry" />
          </mxCell>
        </object>
        <object id="scr-compose" label="Compose" em="screen" slice="queue-message" screen="compose" inputs="campaignId:Guid, subject:string, recipients:string[]" note="recipients is a LIST typed on one screen. That single fact is what makes an EventProjection the right recipe for delivery-log: one event, N documents.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="740" y="200" width="180" height="300" as="geometry" />
          </mxCell>
        </object>
        <object id="scr-deliveries" label="Deliveries" em="screen" slice="record-outcome" screen="deliveries" inputs="messageId:Guid, recipient:string, outcome:string, reason:string?" note="An operator records what the mail provider reported. In a real system this is a webhook and the trigger is an external event; a screen keeps this model inside one context, which is what it is for.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1060" y="200" width="180" height="300" as="geometry" />
          </mxCell>
        </object>
        <object id="cmd-open-campaign" label="OpenCampaign" em="command" slice="open-campaign" aggregate="Campaign" fields="campaignId:Guid, name:string" terminal="campaignId:generated" note="The handler mints the id: a screen cannot supply one for a campaign that does not exist yet.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="100" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="cmd-close-campaign" label="CloseCampaign" em="command" slice="close-campaign" aggregate="Campaign" fields="campaignId:Guid" note="One field, because the decider folds the Campaign stream for everything else.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="420" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="cmd-queue-message" label="QueueMessage" em="command" slice="queue-message" aggregate="Message" fields="messageId:Guid, campaignId:Guid, senderId:Guid, subject:string, recipients:string[]" terminal="messageId:generated, senderId:actor" note="Writes the Message stream only. The rule that the campaign must be open is a cross-stream READ of the Campaign stream, never a second write — one command, one swimlane.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="740" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="cmd-record-outcome" label="RecordOutcome" em="command" slice="record-outcome" aggregate="Message" fields="messageId:Guid, recipient:string, outcome:string, reason:string?" note="One command, two possible events — allowed, and the little book says it should not be the rule. A delivery attempt reports either success or failure, and splitting that into two commands would let a caller claim both for one attempt.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1060" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-campaign-opened" label="CampaignOpened" em="event" slice="open-campaign" aggregate="Campaign" fields="campaignId:Guid, name:string, openedAt:DateTimeOffset" terminal="openedAt:clock" note="Opens the Campaign stream.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="100" y="920" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-campaign-closed" label="CampaignClosed" em="event" slice="close-campaign" aggregate="Campaign" fields="campaignId:Guid, closedAt:DateTimeOffset" terminal="closedAt:clock" note="The second Campaign event, and the reason campaign-dashboard.status is a fold over event PRESENCE rather than a field carried by anything.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="420" y="920" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-message-queued" label="MessageQueued" em="event" slice="queue-message" aggregate="Message" fields="messageId:Guid, campaignId:Guid, senderId:Guid, subject:string, recipients:string[], queuedAt:DateTimeOffset" terminal="queuedAt:clock" note="Feeds all five views, and is the only Message event carrying campaignId. That asymmetry is deliberate — see the note on campaign-dashboard.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="740" y="1020" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-message-delivered" label="MessageDelivered" em="event" slice="record-outcome" aggregate="Message" fields="messageId:Guid, recipient:string, deliveredAt:DateTimeOffset" terminal="deliveredAt:clock" note="Carries no campaignId. A delivery notification is a fact about a message and its recipient; duplicating the campaign onto it just to make a projection easy would be the tail wagging the dog.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1020" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-message-bounced" label="MessageBounced" em="event" slice="record-outcome" aggregate="Message" fields="messageId:Guid, recipient:string, reason:string, bouncedAt:DateTimeOffset" terminal="bouncedAt:clock" note="Drawn in the same swimlane as its sibling because its stream is the same. Two rows inside one band is what a slice emitting two events looks like.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1095" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="rm-message-status" label="MessageStatus" em="readmodel" slice="message-status" identity="messageId" fields="messageId:Guid, campaignId:Guid, subject:string, recipientCount:int, delivered:int, bounced:int, status:string" derived="recipientCount=recipients, delivered=MessageDelivered, bounced=MessageBounced, status=MessageQueued+MessageDelivered+MessageBounced" note="One row per Message stream, fed only by that stream's own events. That is the definition of a SINGLE-STREAM projection — and equally the definition of a live fold, which needs no registration and no table at all. Both are built, so the cost of the table is visible.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1380" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="rm-delivery-log" label="DeliveryLog" em="readmodel" slice="delivery-log" identity="messageId, recipient" fields="messageId:Guid, campaignId:Guid, recipient:string, subject:string, queuedAt:DateTimeOffset" derived="recipient=recipients" note="One row per RECIPIENT of a message, and one MessageQueued event creates all of them at once. No aggregation can express that: an aggregation folds many events into one row, this fans one event into many. That is what EventProjection is for.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1700" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="rm-campaign-dashboard" label="CampaignDashboard" em="readmodel" slice="campaign-dashboard" identity="campaignId" fields="campaignId:Guid, name:string, status:string, queued:int, delivered:int, bounced:int" derived="status=CampaignOpened+CampaignClosed, queued=MessageQueued, delivered=MessageDelivered, bounced=MessageBounced" note="One row per campaign, fed by BOTH stream types. Campaign events carry campaignId and MessageQueued carries it too, so those group with Identity&lt;T&gt;. MessageDelivered and MessageBounced do NOT carry it, so they need a custom grouper over a lookup — which is the honest cost of not denormalising the key onto every event.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="2020" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="rm-sender-monthly" label="SenderMonthly" em="readmodel" slice="sender-monthly" identity="senderId, month" fields="senderId:Guid, month:string, messages:int, recipients:int" derived="month=MessageQueued, messages=MessageQueued, recipients=recipients" note="One row per sender per calendar month, rolled up over MANY streams of ONE type. month is not a field of any event — it comes from the event's own timestamp, which the model has no way to name, so it is declared derived from the event itself.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="2340" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="rm-message-metrics" label="MessageMetrics" em="readmodel" slice="message-metrics" identity="messageId" fields="messageId:Guid, campaignId:Guid, senderId:Guid, recipientCount:int, delivered:int, bounced:int, queuedAt:DateTimeOffset" derived="recipientCount=recipients, delivered=MessageDelivered, bounced=MessageBounced" note="Deliberately the SAME grain as MessageStatus. The duplication is the comparison: this one is a flat SQL table rather than a JSONB document, so it answers 'delivery rate by campaign by day' with a GROUP BY instead of a fold. Same events, same identity, a different storage shape.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="2660" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="e-scr-campaigns-open--cmd-open-campaign" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="scr-campaigns-open" target="cmd-open-campaign">
          <mxGeometry relative="1" as="geometry" />
