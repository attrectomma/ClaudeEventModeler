        <mxCell id="e-evt-message-queued--rm-delivery-log" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.4;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-message-queued" target="rm-delivery-log">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="812" y="760" />
