<mxfile host="Electron" agent="Claude" type="device">
  <diagram name="email-outbox" id="context">
    <mxGraphModel dx="1420" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="1730" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object id="model-email-outbox" label="Email outbox&#10;email-outbox · context" em="model" context="email-outbox" system="email-outbox" note="A reference model, not a domain. It exists so the four ways of implementing an Automation slice can be compared against ONE model — the point being that the model does not choose between them.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
            <mxGeometry x="40" y="30" width="300" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-ui" label="UI / Wireframes — frontend-agent" em="lane" owner="frontend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="160" width="940" height="390" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-cmd" label="Commands / Views / Automation — backend-agent" em="lane" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="550" width="940" height="180" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-evt" label="Event Stream — backend-agent" em="lane" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="870" width="940" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="swim-email" label="Email stream — one stream per email" em="lane" streams="Email" identity="emailId">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#dddddd;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=2;fontColor=#999999;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="40" y="895" width="940" height="95" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-gwt" label="Given / When / Then — one cell per business rule, stacked under its slice" em="lane">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="1230" width="940" height="440" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-prepare-email" label="prepare-email&#10;state-change · ready" em="group" slice="prepare-email" pattern="state-change" status="ready" owners="backend-agent, frontend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="80" y="140" width="220" height="860" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-send-email" label="send-email&#10;automation · ready" em="group" slice="send-email" pattern="automation" status="ready" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="400" y="140" width="540" height="860" as="geometry" />
          </mxCell>
        </object>
        <object id="scr-compose" label="Compose" em="screen" slice="prepare-email" screen="compose" inputs="to:string, subject:string, body:string" note="A human writes an email. The only human in this model — everything after EmailPrepared happens without one, which is the point.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="100" y="200" width="180" height="300" as="geometry" />
          </mxCell>
        </object>
        <object id="cmd-prepare-email" label="PrepareEmail" em="command" slice="prepare-email" aggregate="Email" fields="emailId:Guid, to:string, subject:string, body:string" terminal="emailId:generated" note="emailId is minted by the handler: the screen cannot supply an id for a thing that does not exist yet.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="100" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-email-prepared" label="EmailPrepared" em="event" slice="prepare-email" aggregate="Email" fields="emailId:Guid, to:string, subject:string, body:string, preparedAt:DateTimeOffset" terminal="preparedAt:clock" note="OURS — appended in our own transaction. That single fact is what makes event forwarding and subscriptions available as implementations of send-email.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="100" y="920" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="rm-emails-to-send" label="EmailsToSend" em="readmodel" slice="send-email" identity="emailId" fields="emailId:Guid, to:string, subject:string, body:string, status:string" derived="status=EmailPrepared+EmailSent" note="The todo list. status is a fold over event PRESENCE — Pending until an EmailSent arrives — which is why no rename could ever produce it.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="420" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="auto-email-processor" label="EmailProcessor" em="automation" slice="send-email" note="The Automated Trigger. It reads the View and issues a Command; it never receives an event and never appends one. HOW it is woken is not drawn, and deliberately so — four implementations of exactly this cell are in ../src.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="740" y="580" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="cmd-send-email" label="SendEmail" em="command" slice="send-email" aggregate="Email" fields="emailId:Guid" note="One field, because the decider folds the stream for the rest. A command carrying to/subject/body would let the trigger send something the stream never prepared.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="740" y="650" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-email-sent" label="EmailSent" em="event" slice="send-email" aggregate="Email" fields="emailId:Guid, providerMessageId:string, sentAt:DateTimeOffset" terminal="providerMessageId:generated, sentAt:clock" note="Completion. It feeds EmailsToSend to tick the row off — never to create one, or the trigger would treat its own output as fresh work.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="740" y="920" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="e-scr-compose--cmd-prepare-email" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="scr-compose" target="cmd-prepare-email">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cmd-prepare-email--evt-email-prepared" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd-prepare-email" target="evt-email-prepared">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-evt-email-prepared--rm-emails-to-send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-email-prepared" target="rm-emails-to-send">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="950" />
              <mxPoint x="390" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-email-sent--rm-emails-to-send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-email-sent" target="rm-emails-to-send">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="830" y="1025" />
              <mxPoint x="510" y="1025" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-rm-emails-to-send--auto-email-processor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rm-emails-to-send" target="auto-email-processor">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="630" />
              <mxPoint x="680" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-auto-email-processor--cmd-send-email" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="auto-email-processor" target="cmd-send-email">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cmd-send-email--evt-email-sent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd-send-email" target="evt-email-sent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="gwt-prepare-email-1" label="an email a human composed is queued, not sent&#10;&#10;GIVEN —&#10;WHEN PrepareEmail&#10;THEN EmailPrepared" em="gwt" slice="prepare-email" rule="an email a human composed is queued, not sent" when="PrepareEmail" then="EmailPrepared" note="The split that makes this model worth having: composing and sending are two slices, so the second one can be automated.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="100" y="1260" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-prepare-email-2" label="an email with no recipient is refused&#10;&#10;GIVEN —&#10;WHEN PrepareEmail&#10;THEN error: RecipientRequired" em="gwt" slice="prepare-email" rule="an email with no recipient is refused" when="PrepareEmail" then="error: RecipientRequired" enforce="periphery" note="No prior events are needed to settle it, so it is the one rule here that belongs in a validator.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="100" y="1400" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-send-email-1" label="a prepared email is sent&#10;&#10;GIVEN EmailPrepared&#10;WHEN SendEmail&#10;THEN EmailSent" em="gwt" slice="send-email" rule="a prepared email is sent" given="EmailPrepared" when="SendEmail" then="EmailSent" note="The happy path, and the only assertion every one of the four implementations must satisfy identically.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="420" y="1260" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-send-email-2" label="an email already sent is not sent twice&#10;&#10;GIVEN EmailPrepared, EmailSent&#10;WHEN SendEmail&#10;THEN error: AlreadySent" em="gwt" slice="send-email" rule="an email already sent is not sent twice" given="EmailPrepared, EmailSent" when="SendEmail" then="error: AlreadySent" enforce="aggregate" note="At-least-once delivery is the normal case for every implementation here, so this rule is what makes any of them safe rather than a nice-to-have.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="420" y="1400" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-send-email-3" label="an email nobody prepared cannot be sent&#10;&#10;GIVEN —&#10;WHEN SendEmail&#10;THEN error: NotPrepared" em="gwt" slice="send-email" rule="an email nobody prepared cannot be sent" when="SendEmail" then="error: NotPrepared" enforce="aggregate" note="Needs the stream to be empty, so it cannot be a validator rule even though its given= is blank — which is why enforce= is declared and not derived.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="420" y="1540" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
