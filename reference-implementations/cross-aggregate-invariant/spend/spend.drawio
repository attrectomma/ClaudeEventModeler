        <object id="gwt-budget-2" label="The budget may be raised at any time&#10;&#10;GIVEN Department Budget Set(budget=100000)&#10;WHEN SetBudget(budget=150000)&#10;THEN Department Budget Set(budget=150000)" em="gwt" slice="set-budget" rule="The budget may be raised at any time" given="Department Budget Set(budget=100000)" when="SetBudget(budget=150000)" then="Department Budget Set(budget=150000)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="420" y="1515" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-open-1" label="A project is opened inside a department&#10;&#10;GIVEN —&#10;WHEN OpenProject(name=Rewire the hall)&#10;THEN Project Opened(name=Rewire the hall)" em="gwt" slice="open-project" rule="A project is opened inside a department" when="OpenProject(name=Rewire the hall)" then="Project Opened(name=Rewire the hall)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="1375" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-commit-1" label="Spend within the department's remaining budget is committed&#10;&#10;GIVEN Department Budget Set(budget=100000)&#10;WHEN CommitSpend(amount=40000)&#10;THEN Spend Committed(amount=40000)" em="gwt" slice="commit-spend" rule="Spend within the department's remaining budget is committed" given="Department Budget Set(budget=100000)" when="CommitSpend(amount=40000)" then="Spend Committed(amount=40000)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1375" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-commit-2" label="THE CROSS-AGGREGATE RULE — spend in ANOTHER project counts against the same budget&#10;&#10;GIVEN Spend Committed(projectId=$ProjectB, amount=70000)&#10;WHEN CommitSpend(projectId=$ProjectA, amount=40000)&#10;THEN error: DepartmentBudgetExceeded" em="gwt" slice="commit-spend" rule="Spend in another project of the same department counts against the budget" given="Spend Committed(projectId=$ProjectB, amount=70000)" when="CommitSpend(projectId=$ProjectA, amount=40000)" then="error: DepartmentBudgetExceeded">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1515" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-commit-3" label="Committing exactly the remaining budget is allowed&#10;&#10;GIVEN Spend Committed(amount=60000)&#10;WHEN CommitSpend(amount=40000)&#10;THEN Spend Committed(amount=40000)" em="gwt" slice="commit-spend" rule="Committing exactly the remaining budget is allowed" given="Spend Committed(amount=60000)" when="CommitSpend(amount=40000)" then="Spend Committed(amount=40000)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1655" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-commit-4" label="A release frees the budget for a later commitment&#10;&#10;GIVEN Commitment Released(amount=70000)&#10;WHEN CommitSpend(amount=40000)&#10;THEN Spend Committed(amount=40000)" em="gwt" slice="commit-spend" rule="A release frees the budget for a later commitment" given="Commitment Released(amount=70000)" when="CommitSpend(amount=40000)" then="Spend Committed(amount=40000)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1795" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-release-1" label="A released commitment returns to the available budget&#10;&#10;GIVEN Spend Committed(amount=40000)&#10;WHEN ReleaseCommitment(amount=40000)&#10;THEN Commitment Released(amount=40000)" em="gwt" slice="release-commitment" rule="A released commitment returns to the available budget" given="Spend Committed(amount=40000)" when="ReleaseCommitment(amount=40000)" then="Commitment Released(amount=40000)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="1375" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-release-2" label="A project cannot release more than it committed&#10;&#10;GIVEN Spend Committed(amount=40000)&#10;WHEN ReleaseCommitment(amount=50000)&#10;THEN error: ReleaseExceedsCommitment" em="gwt" slice="release-commitment" rule="A project cannot release more than it committed" given="Spend Committed(amount=40000)" when="ReleaseCommitment(amount=50000)" then="error: ReleaseExceedsCommitment">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="1515" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
      </root>
