<mxfile host="Electron" agent="Claude" type="device">
  <diagram name="allocation" id="context">
    <mxGraphModel dx="1420" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="2155" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object id="model-allocation" label="Allocation of a limited pool&#10;Allocation · allocation" em="model" context="allocation" system="Allocation" note="A REFERENCE IMPLEMENTATION, not a domain. It carries exactly one problem: the Reservation Pattern of Understanding EventSourcing ch. 36 — reserve a unit of a limited resource, then execute against the reservation, and give back the unit when the execution fails. Nothing here is a business claim. NOTE WHAT IS NOT ON THIS CANVAS: no pattern= value called 'reservation', no new attribute, no marker saying these two slices are a pair. The pattern is a COMPOSITION of a state change and an automation, and that is the finding this folder exists to state.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
            <mxGeometry x="40" y="30" width="300" height="90" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-ui" label="UI / Wireframes — frontend-agent" em="lane" owner="frontend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="160" width="2200" height="390" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-cmd" label="Commands / Views / Automation — backend-agent" em="lane" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="550" width="2200" height="180" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-evt" label="Event Stream — backend-agent" em="lane" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="870" width="2200" height="415" as="geometry" />
          </mxCell>
        </object>
        <object id="swim-pool" label="Pool stream — one per pool. The limited resource itself" em="lane" streams="Pool" identity="poolId">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#dddddd;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=2;fontColor=#999999;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="40" y="895" width="2200" height="95" as="geometry" />
          </mxCell>
        </object>
        <object id="swim-slot" label="Slot stream — ONE STREAM PER UNIT OF THE POOL. The contested thing IS the stream id, which is the whole trick of ch. 36" em="lane" streams="Slot" identity="poolId, slotNumber">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#dddddd;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=2;fontColor=#999999;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="40" y="1000" width="2200" height="95" as="geometry" />
          </mxCell>
        </object>
        <object id="swim-grant" label="Grant stream — one per execution. What the reservation was FOR" em="lane" streams="Grant" identity="grantId">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#dddddd;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=2;fontColor=#999999;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="40" y="1105" width="2200" height="180" as="geometry" />
          </mxCell>
        </object>
        <object id="lane-gwt" label="Given / When / Then — one cell per business rule, stacked under its slice" em="lane">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
            <mxGeometry x="40" y="1525" width="2200" height="590" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-pool-availability" label="pool-availability&#10;state-view · ready" em="group" slice="pool-availability" pattern="state-view" status="ready" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="80" y="140" width="220" height="1150" as="geometry" />
          </mxCell>
        </object>
        <object id="rm-pool-availability" label="PoolAvailability" em="readmodel" slice="pool-availability" identity="poolId" fields="poolId:Guid, capacity:int, taken:int, remaining:int, takenSlots:int[]" derived="taken=Slot Reserved+Slot Released, remaining=capacity+Slot Reserved+Slot Released, takenSlots=Slot Reserved+Slot Released" note="A HINT, NEVER THE DECIDER'S INPUT. It spans the Pool stream and every Slot stream, so it is multi-stream and therefore Async — it is allowed to be stale. The reserve decider must not read it to enforce the limit (ANTI-PATTERNS #17): the guarantee lives on the Slot stream, and this row only tells a human, and the handler's first guess, where to look.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="100" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-open-pool" label="open-pool&#10;state-change · ready" em="group" slice="open-pool" pattern="state-change" status="ready" owners="backend-agent, frontend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="400" y="140" width="220" height="1150" as="geometry" />
          </mxCell>
        </object>
        <object id="scr-open-pool" label="Pool Setup" em="screen" slice="open-pool" screen="pool-setup" inputs="capacity" note="Deliberately a SECOND screen rather than a second affordance on the desk. The desk displays a capacity that already exists; this one types the capacity of a pool that does not — same word, opposite meaning, and a name-match cannot tell them apart. Keeping them separate is also what stops this model needing joins=.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="410" y="200" width="200" height="240" as="geometry" />
          </mxCell>
        </object>
        <object id="cmd-open-pool" label="OpenPool" em="command" slice="open-pool" aggregate="Pool" fields="poolId:Guid, capacity:int" terminal="poolId:generated" note="capacity is the ONLY thing that makes the resource limited. Everything downstream — the slot numbers, the exhaustion rule, the compensating release — is arithmetic on this one number.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="420" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-pool-opened" label="Pool Opened" em="event" slice="open-pool" aggregate="Pool" fields="poolId:Guid, capacity:int, openedAt:DateTimeOffset" terminal="openedAt:clock" note="The one event on the Pool stream. Note what it does NOT do: it keeps no running count of reservations. A counter here would be the thing two concurrent reservers race on, and it is exactly what the pattern replaces.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="420" y="920" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-reserve-slot" label="reserve-slot&#10;state-change · ready" em="group" slice="reserve-slot" pattern="state-change" status="ready" owners="backend-agent, frontend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="720" y="140" width="220" height="1150" as="geometry" />
          </mxCell>
        </object>
        <object id="scr-reserve-slot" label="Pool Desk" em="screen" slice="reserve-slot" screen="pool-desk" displays="poolId, capacity, taken, remaining, takenSlots" note="Everything it shows comes from an Async view, so everything it shows may be stale. That is survivable HERE and nowhere else in this model: a human who asks for a slot that has just gone gets a refusal, not a double booking.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="730" y="200" width="200" height="240" as="geometry" />
          </mxCell>
        </object>
        <object id="cmd-reserve-slot" label="ReserveSlot" em="command" slice="reserve-slot" aggregate="Slot" fields="poolId:Guid, grantId:Guid" terminal="grantId:generated" note="STEP ONE OF TWO. It does not name a slot number: which unit you get is the decider's answer, not the caller's request. grantId is minted here so that step two has something to execute against before step two has run.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="740" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-slot-reserved" label="Slot Reserved" em="event" slice="reserve-slot" aggregate="Slot" fields="poolId:Guid, slotNumber:int, grantId:Guid, reservedAt:DateTimeOffset" terminal="slotNumber:generated, reservedAt:clock" note="THE RESERVATION. It is appended to the stream slot:{poolId}:{slotNumber}, so two reservers who pick the same number are two writers on ONE stream and ordinary optimistic concurrency separates them. slotNumber is terminal=generated because the decider picks it — the kit has no terminal kind for 'chosen by the decider from state', and generated is the closest honest one.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="740" y="1025" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-issue-grant" label="issue-grant&#10;automation · ready" em="group" slice="issue-grant" pattern="automation" status="ready" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="1040" y="140" width="540" height="1150" as="geometry" />
          </mxCell>
        </object>
        <object id="rm-slots-to-issue" label="SlotsToIssue" em="readmodel" slice="issue-grant" identity="grantId" fields="grantId:Guid, poolId:Guid, slotNumber:int, status:string" derived="status=Slot Reserved+Grant Issued+Grant Refused" note="The todo list of ch. 35. A reservation puts the row on it; either outcome of the execution ticks it off. Being fed by two stream types makes it multi-stream and therefore Async — which is the hazard of UES ch. 32 in this model, and is measured rather than assumed in the README.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1060" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="auto-grant-issuer" label="GrantIssuer" em="automation" slice="issue-grant" note="STEP TWO OF TWO. The book says the whole cycle 'can be done within one single web-request' — so what wakes this cell is not drawn, exactly as in ../automation. Two implementations of this box are in ../generated, and one of them is not woken at all: it is called synchronously by step one.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1380" y="580" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="cmd-issue-grant" label="IssueGrant" em="command" slice="issue-grant" aggregate="Grant" fields="grantId:Guid, poolId:Guid, slotNumber:int" note="It carries the slot it is executing against, so a grant can never exist without the reservation that paid for it.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1380" y="650" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-grant-issued" label="Grant Issued" em="event" slice="issue-grant" aggregate="Grant" fields="grantId:Guid, poolId:Guid, slotNumber:int, issuedAt:DateTimeOffset" terminal="issuedAt:clock" note="The execution succeeded. The reservation is now spent, and nothing ever releases the slot.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1380" y="1115" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-grant-refused" label="Grant Refused" em="event" slice="issue-grant" aggregate="Grant" fields="grantId:Guid, poolId:Guid, slotNumber:int, reason:string, refusedAt:DateTimeOffset" terminal="reason:generated, refusedAt:clock" note="THE EVENT THE WHOLE PATTERN EXISTS FOR. Execution failing is not a rejected command — the command was legal and the work said no — so it is recorded as a fact, and that fact is what opens the compensating slice. reason is terminal=generated only because the kit has no kind for 'an answer from the work the command performed'; see the README's findings.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1380" y="1210" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="slice-release-slot" label="release-slot&#10;automation · ready" em="group" slice="release-slot" pattern="automation" status="ready" owner="backend-agent">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
            <mxGeometry x="1680" y="140" width="540" height="1150" as="geometry" />
          </mxCell>
        </object>
        <object id="rm-slots-to-release" label="SlotsToRelease" em="readmodel" slice="release-slot" identity="grantId" fields="grantId:Guid, poolId:Guid, slotNumber:int, reason:string, status:string" derived="status=Grant Refused+Slot Released" note="The compensation's own todo list. A refusal opens the row, the release closes it — and a release that itself fails simply leaves the row open to be retried, which is ch. 35's answer to the whole saga question and needs no framework.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="1700" y="600" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="auto-slot-releaser" label="SlotReleaser" em="automation" slice="release-slot" note="THE COMPENSATING TRANSACTION, and it is an ordinary automation cell. Nothing on this canvas says it is compensating anything; that is carried entirely by which events feed its todo list.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="2020" y="580" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="cmd-release-slot" label="ReleaseSlot" em="command" slice="release-slot" aggregate="Slot" fields="poolId:Guid, slotNumber:int, grantId:Guid, reason:string" note="It appends back onto the Slot stream — the same stream the reservation opened — so the release is subject to the same optimistic concurrency as the reservation was.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="2020" y="650" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="evt-slot-released" label="Slot Released" em="event" slice="release-slot" aggregate="Slot" fields="poolId:Guid, slotNumber:int, grantId:Guid, reason:string, releasedAt:DateTimeOffset" terminal="releasedAt:clock" note="The unit goes back into the pool. This event is why the reserve decider cannot be a bare StartStream collision: a released slot's stream already exists, so re-reserving it has to be a FETCH AND FOLD, not a create.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="2020" y="1025" width="180" height="60" as="geometry" />
          </mxCell>
        </object>
