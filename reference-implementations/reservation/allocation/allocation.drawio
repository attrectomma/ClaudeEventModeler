        <mxCell id="e-auto-grant-issuer--cmd-issue-grant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="auto-grant-issuer" target="cmd-issue-grant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cmd-issue-grant--evt-grant-issued" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd-issue-grant" target="evt-grant-issued">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cmd-issue-grant--evt-grant-refused" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd-issue-grant" target="evt-grant-refused">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="680" />
              <mxPoint x="1300" y="1240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-grant-refused--rm-slots-to-release" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-grant-refused" target="rm-slots-to-release">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1620" y="1240" />
              <mxPoint x="1620" y="744" />
              <mxPoint x="1790" y="744" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-evt-slot-released--rm-slots-to-release" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evt-slot-released" target="rm-slots-to-release">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2110" y="1345" />
              <mxPoint x="1790" y="1345" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-rm-slots-to-release--auto-slot-releaser" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rm-slots-to-release" target="auto-slot-releaser">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1960" y="630" />
              <mxPoint x="1960" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-auto-slot-releaser--cmd-release-slot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="auto-slot-releaser" target="cmd-release-slot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cmd-release-slot--evt-slot-released" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd-release-slot" target="evt-slot-released">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="gt-availability-1" label="A pool nobody has reserved from shows all of its capacity&#10;&#10;GIVEN Pool Opened(capacity=3)&#10;THEN PoolAvailability(capacity=3, taken=0, remaining=3)" em="gwt" slice="pool-availability" rule="A pool nobody has reserved from shows all of its capacity" given="Pool Opened(capacity=3)" then="PoolAvailability(capacity=3, taken=0, remaining=3)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="100" y="1555" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-availability-2" label="A reserved slot is taken, and is named&#10;&#10;GIVEN Pool Opened(capacity=3), Slot Reserved(slotNumber=1)&#10;THEN PoolAvailability(taken=1, remaining=2, takenSlots=1)" em="gwt" slice="pool-availability" rule="A reserved slot is taken, and is named" given="Pool Opened(capacity=3), Slot Reserved(slotNumber=1)" then="PoolAvailability(taken=1, remaining=2, takenSlots=1)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="100" y="1695" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-availability-3" label="A released slot goes back into the pool&#10;&#10;GIVEN Pool Opened(capacity=3), Slot Reserved(slotNumber=1), Slot Released(slotNumber=1)&#10;THEN PoolAvailability(taken=0, remaining=3)" em="gwt" slice="pool-availability" rule="A released slot goes back into the pool" given="Pool Opened(capacity=3), Slot Reserved(slotNumber=1), Slot Released(slotNumber=1)" then="PoolAvailability(taken=0, remaining=3)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="100" y="1835" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gt-availability-4" label="WHAT IT IGNORES — issuing a grant consumes no further capacity&#10;&#10;GIVEN Pool Opened(capacity=3), Slot Reserved(slotNumber=1), Grant Issued(slotNumber=1)&#10;THEN PoolAvailability(taken=1, remaining=2)" em="gwt" slice="pool-availability" rule="Issuing a grant against an already reserved slot consumes no further capacity" given="Pool Opened(capacity=3), Slot Reserved(slotNumber=1), Grant Issued(slotNumber=1)" then="PoolAvailability(taken=1, remaining=2)" note="The reservation is what costs a unit; the execution costs nothing. Nothing but this GT makes that claim executable, and it is the one thing a projection fed by three streams can most easily get wrong.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="100" y="1975" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-open-pool-1" label="A pool is opened with a fixed capacity&#10;&#10;GIVEN —&#10;WHEN OpenPool(capacity=3)&#10;THEN Pool Opened(capacity=3)" em="gwt" slice="open-pool" rule="A pool is opened with a fixed capacity" when="OpenPool(capacity=3)" then="Pool Opened(capacity=3)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="420" y="1555" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-open-pool-2" label="A pool with no capacity is refused&#10;&#10;GIVEN —&#10;WHEN OpenPool(capacity=0)&#10;THEN error: CapacityMustBePositive" em="gwt" slice="open-pool" rule="A pool with no capacity is refused" when="OpenPool(capacity=0)" then="error: CapacityMustBePositive" enforce="periphery" note="The request alone settles it, so it is the one rule in this model that belongs in a validator.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="420" y="1695" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-reserve-1" label="The first reservation takes the lowest slot&#10;&#10;GIVEN Pool Opened(capacity=3)&#10;WHEN ReserveSlot&#10;THEN Slot Reserved(slotNumber=1)" em="gwt" slice="reserve-slot" rule="The first reservation takes the lowest slot" given="Pool Opened(capacity=3)" when="ReserveSlot" then="Slot Reserved(slotNumber=1)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="1555" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-reserve-2" label="A second reservation takes the next slot&#10;&#10;GIVEN Pool Opened(capacity=3), Slot Reserved(slotNumber=1)&#10;WHEN ReserveSlot&#10;THEN Slot Reserved(slotNumber=2)" em="gwt" slice="reserve-slot" rule="A second reservation takes the next slot" given="Pool Opened(capacity=3), Slot Reserved(slotNumber=1)" when="ReserveSlot" then="Slot Reserved(slotNumber=2)" enforce="aggregate">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="1695" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-reserve-3" label="THE LIMIT — a pool with every slot taken refuses a reservation&#10;&#10;GIVEN Pool Opened(capacity=1), Slot Reserved(slotNumber=1)&#10;WHEN ReserveSlot&#10;THEN error: PoolExhausted" em="gwt" slice="reserve-slot" rule="A pool with every slot taken refuses a reservation" given="Pool Opened(capacity=1), Slot Reserved(slotNumber=1)" when="ReserveSlot" then="error: PoolExhausted" enforce="aggregate" note="The rule the resource is limited BY. It is sequential, like every GWT, so it passes against a decider with no concurrency guard at all — which is why the race tests exist and why architect asks.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="1835" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-reserve-4" label="A released slot can be reserved again&#10;&#10;GIVEN Pool Opened(capacity=1), Slot Reserved(slotNumber=1), Slot Released(slotNumber=1)&#10;WHEN ReserveSlot&#10;THEN Slot Reserved(slotNumber=1)" em="gwt" slice="reserve-slot" rule="A released slot can be reserved again" given="Pool Opened(capacity=1), Slot Reserved(slotNumber=1), Slot Released(slotNumber=1)" when="ReserveSlot" then="Slot Reserved(slotNumber=1)" enforce="aggregate" note="THE RULE THAT DECIDES THE MECHANISM. A slot that can come back means the reservation stream already exists on the second attempt, so 'reserve' cannot be a bare StartStream collision — it must fetch and fold. That is exactly the book's ReserveEmailAggregate, which checks a reserved flag rather than relying on creation.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="1975" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-issue-1" label="A reserved slot is executed into a grant&#10;&#10;GIVEN Slot Reserved(grantId=$AcceptedGrant, slotNumber=1)&#10;WHEN IssueGrant(grantId=$AcceptedGrant)&#10;THEN Grant Issued(grantId=$AcceptedGrant, slotNumber=1)" em="gwt" slice="issue-grant" rule="A reserved slot is executed into a grant" given="Slot Reserved(grantId=$AcceptedGrant, slotNumber=1)" when="IssueGrant(grantId=$AcceptedGrant)" then="Grant Issued(grantId=$AcceptedGrant, slotNumber=1)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1555" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-issue-2" label="A grant already issued is not issued twice&#10;&#10;GIVEN Slot Reserved(grantId=$AcceptedGrant), Grant Issued(grantId=$AcceptedGrant)&#10;WHEN IssueGrant(grantId=$AcceptedGrant)&#10;THEN error: AlreadyIssued" em="gwt" slice="issue-grant" rule="A grant already issued is not issued twice" given="Slot Reserved(grantId=$AcceptedGrant), Grant Issued(grantId=$AcceptedGrant)" when="IssueGrant(grantId=$AcceptedGrant)" then="error: AlreadyIssued" enforce="aggregate" note="Every wakeup mechanism in this kit is at-least-once, so this is what makes any of them safe. The rule catches the sequential duplicate; the stream's own version catches the simultaneous one.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1695" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-issue-3" label="EXECUTION THAT THE WORK REFUSES IS RECORDED, NOT THROWN AWAY&#10;&#10;GIVEN Slot Reserved(grantId=$RefusedGrant, slotNumber=1)&#10;WHEN IssueGrant(grantId=$RefusedGrant)&#10;THEN Grant Refused(grantId=$RefusedGrant, slotNumber=1)" em="gwt" slice="issue-grant" rule="Execution the work refuses is recorded as a fact rather than thrown away" given="Slot Reserved(grantId=$RefusedGrant, slotNumber=1)" when="IssueGrant(grantId=$RefusedGrant)" then="Grant Refused(grantId=$RefusedGrant, slotNumber=1)" enforce="aggregate" note="Same GIVEN and same WHEN as the happy path — only the example data differs, because whether the work succeeds is not something the model can state. $RefusedGrant is the seeded id the test executor says no to. This is the one place the notation genuinely runs out.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="1835" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-release-1" label="A refused grant gives its slot back&#10;&#10;GIVEN Slot Reserved(slotNumber=1), Grant Refused(slotNumber=1)&#10;WHEN ReleaseSlot(slotNumber=1)&#10;THEN Slot Released(slotNumber=1)" em="gwt" slice="release-slot" rule="A refused grant gives its slot back" given="Slot Reserved(slotNumber=1), Grant Refused(slotNumber=1)" when="ReleaseSlot(slotNumber=1)" then="Slot Released(slotNumber=1)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1555" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-release-2" label="A slot already given back is not released twice&#10;&#10;GIVEN Slot Reserved(slotNumber=1), Grant Refused(slotNumber=1), Slot Released(slotNumber=1)&#10;WHEN ReleaseSlot(slotNumber=1)&#10;THEN error: AlreadyReleased" em="gwt" slice="release-slot" rule="A slot already given back is not released twice" given="Slot Reserved(slotNumber=1), Grant Refused(slotNumber=1), Slot Released(slotNumber=1)" when="ReleaseSlot(slotNumber=1)" then="error: AlreadyReleased" enforce="aggregate" note="A compensating command is redelivered like any other, and a second release would hand the same unit back twice — so the pool would grow past its own capacity.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1695" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
