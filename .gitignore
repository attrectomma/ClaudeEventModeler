node_modules/

# Purchased books — reference material, never committed. Includes text extracted
# from them by tools/pdf-text.mjs.
*.pdf
*.epub
reference/

# Rendered previews are build output — regenerate with tools/drawio.mjs render
*.png

# verifier scratch
diagrams/.verify-tmp.drawio

# derived IR — regenerate with tools/model.mjs compile
build/

# .NET build output. The generated *.cs files ARE committed: their diff is how a model
# change gets reviewed.
generated/**/bin/
generated/**/obj/

# Generated design previews — regenerate with tools/design.mjs sheet
designs/*/index.html
designs/*/_shots/

# Vite build output and installed packages under generated/
generated/**/web/dist/
generated/**/web/.vite/
