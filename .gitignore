node_modules/

# Which project THIS copy of the kit writes to. Machine-specific by definition — an absolute path
# on someone else's disk. Every copy configures its own:
#   node tools/project.mjs init --project <path>
project.json

# Purchased books — reference material, never committed. Includes text extracted
# from them by tools/pdf-text.mjs.
*.pdf
*.epub
reference/

# Rendered previews are build output — regenerate with tools/drawio.mjs render.
# tools/fixtures/cart/cart.drawio is NOT covered by this and is committed on purpose:
# "byte-identical on re-run" is the assertion cart-replay.mjs makes.
*.png

# verifier scratch
templates/.verify-tmp.drawio

# .NET build output. The generated *.cs files ARE committed: their diff is how a model
# change gets reviewed. Not anchored to generated/ — reference-implementations/ has its own
# projects, and a root-relative pattern silently missed them.
**/bin/
**/obj/

# NOTHING ELSE BELONGS HERE. diagrams/, designs/, build/ and generated/ are the PROJECT's, not the
# kit's: they live under the project root, covered by the .gitignore that `project.mjs init` writes
# there. If one of them ever appears in this folder, some tool resolved a path against the kit
# instead of the project — which is a bug to fix, not something to ignore.
