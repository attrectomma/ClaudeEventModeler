        <object id="gwt-start-month-1" label="every project member gets a booking month opened for them&#10;&#10;GIVEN EmployeeAssignedToProject&#10;WHEN StartBookingMonth&#10;THEN BookingMonthStarted" em="gwt" slice="start-month" rule="every project member gets a booking month opened for them" given="EmployeeAssignedToProject" when="StartBookingMonth" then="BookingMonthStarted" source="&quot;an automation that starts each new month for each employee with a BookingMonthStarted event&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
