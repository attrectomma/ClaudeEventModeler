        <object id="gwt-submit-closure-1" label="an employee closes their own month, which submits it rather than closing it&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN SubmitMonthClosure&#10;THEN MonthClosureSubmitted" em="gwt" slice="submit-closure" rule="an employee closes their own month, which submits it rather than closing it" given="BookingMonthStarted" when="SubmitMonthClosure" then="MonthClosureSubmitted" source="&quot;The month can be closed by the employee or by an admin&quot;">
