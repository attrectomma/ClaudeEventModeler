          </mxCell>
        </object>
        <object id="gwt-book-hours-4" label="zero hours is not a booking — removal is the only way to take a line back&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN BookHours&#10;THEN error: HoursMustBeNonZero" em="gwt" slice="book-hours" rule="zero hours is not a booking — removal is the only way to take a line back" given="BookingMonthStarted" when="BookHours" then="error: HoursMustBeNonZero" source="&quot;employees may never book 0 hours, so a HoursBooked with 0 hours would be a business rule violation&quot;" enforce="periphery">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="2220" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-5" label="hours are booked in whole or half hours only&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN BookHours&#10;THEN error: HoursMustBeWholeOrHalf" em="gwt" slice="book-hours" rule="hours are booked in whole or half hours only" given="BookingMonthStarted" when="BookHours" then="error: HoursMustBeWholeOrHalf" source="&quot;date + project + hours spend. Full hours or 0,5 hours.&quot;" enforce="periphery">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="2360" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-6" label="a closed month cannot be booked into — closed is closed&#10;&#10;GIVEN MonthClosed&#10;WHEN BookHours&#10;THEN error: MonthIsClosed" em="gwt" slice="book-hours" rule="a closed month cannot be booked into — closed is closed" given="MonthClosed" when="BookHours" then="error: MonthIsClosed" source="&quot;Any time until the working month isnt closed&quot; / &quot;closed is closed&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="2500" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-7" label="hours cannot be booked to a project the employee has left, and NOTHING is persisted&#10;&#10;GIVEN EmployeeRemovedFromProject&#10;WHEN BookHours&#10;THEN error: NotAProjectMember" em="gwt" slice="book-hours" rule="hours cannot be booked to a project the employee has left, and NOTHING is persisted" given="EmployeeRemovedFromProject" when="BookHours" then="error: NotAProjectMember" source="&quot;it must be rejected, but we do not persist any new event&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="2640" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-8" label="at most 18 hours can stand for one day&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN BookHours&#10;THEN error: DailyCapExceeded" em="gwt" slice="book-hours" rule="at most 18 hours can stand for one day" given="BookingMonthStarted" when="BookHours" then="error: DailyCapExceeded" source="&quot;Cap is 18 hours&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="2780" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-9" label="a day+project can only be BOOKED once — booking it again is a correction, not a booking&#10;&#10;GIVEN HoursBooked&#10;WHEN BookHours&#10;THEN error: AlreadyBookedUseCorrection" em="gwt" slice="book-hours" rule="a day+project can only be BOOKED once — booking it again is a correction, not a booking" given="HoursBooked" when="BookHours" then="error: AlreadyBookedUseCorrection" source="&quot;There may be only one HoursBooked ... that results in either the one HoursBooked or a Correction&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="2920" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-10" label="a submitted month is still open, so it can still be booked into until an admin closes it&#10;&#10;GIVEN MonthClosureSubmitted&#10;WHEN BookHours&#10;THEN HoursBooked" em="gwt" slice="book-hours" rule="a submitted month is still open, so it can still be booked into until an admin closes it" given="MonthClosureSubmitted" when="BookHours" then="HoursBooked" source="&quot;Can you still book into a month you have already submitted? Yes.&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1060" y="3060" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-1" label="a correction carries the new TOTAL for the day, never the difference&#10;&#10;GIVEN HoursBooked&#10;WHEN CorrectHours&#10;THEN HoursCorrected" em="gwt" slice="correct-hours" rule="a correction carries the new TOTAL for the day, never the difference" given="HoursBooked" when="CorrectHours" then="HoursCorrected" source="&quot;a HoursCorrected event carrying the 8 hours, not the 2 difference!&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="1800" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-2" label="the truth for a day+project is the last correction, or the booking if there was none&#10;&#10;GIVEN HoursBooked, HoursCorrected&#10;WHEN CorrectHours&#10;THEN HoursCorrected" em="gwt" slice="correct-hours" rule="the truth for a day+project is the last correction, or the booking if there was none" given="HoursBooked, HoursCorrected" when="CorrectHours" then="HoursCorrected" source="&quot;the final truth is last HoursCorrected event if any, or the HoursBooked if no corrections&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="1940" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-3" label="correcting a day+project that was never booked is not a correction&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN CorrectHours&#10;THEN error: BookingNotFound" em="gwt" slice="correct-hours" rule="correcting a day+project that was never booked is not a correction" given="BookingMonthStarted" when="CorrectHours" then="error: BookingNotFound" source="&quot;There may be only one HoursBooked&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="2080" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-4" label="a correction cannot take the hours to zero — removal is the only way&#10;&#10;GIVEN HoursBooked&#10;WHEN CorrectHours&#10;THEN error: HoursMustBeNonZero" em="gwt" slice="correct-hours" rule="a correction cannot take the hours to zero — removal is the only way" given="HoursBooked" when="CorrectHours" then="error: HoursMustBeNonZero" source="&quot;employees may never book 0 hours&quot;" enforce="periphery">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="2220" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-5" label="corrections are in whole or half hours only&#10;&#10;GIVEN HoursBooked&#10;WHEN CorrectHours&#10;THEN error: HoursMustBeWholeOrHalf" em="gwt" slice="correct-hours" rule="corrections are in whole or half hours only" given="HoursBooked" when="CorrectHours" then="error: HoursMustBeWholeOrHalf" source="&quot;Full hours or 0,5 hours&quot;" enforce="periphery">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="2360" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-6" label="a correction cannot push the day over 18 hours&#10;&#10;GIVEN HoursBooked&#10;WHEN CorrectHours&#10;THEN error: DailyCapExceeded" em="gwt" slice="correct-hours" rule="a correction cannot push the day over 18 hours" given="HoursBooked" when="CorrectHours" then="error: DailyCapExceeded" source="&quot;Cap is 18 hours&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="2500" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-7" label="a closed month cannot be corrected — closed is closed&#10;&#10;GIVEN MonthClosed&#10;WHEN CorrectHours&#10;THEN error: MonthIsClosed" em="gwt" slice="correct-hours" rule="a closed month cannot be corrected — closed is closed" given="MonthClosed" when="CorrectHours" then="error: MonthIsClosed" source="&quot;Any time until the working month isnt closed&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="2640" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-8" label="a submitted month is still open, so it can still be corrected&#10;&#10;GIVEN MonthClosureSubmitted&#10;WHEN CorrectHours&#10;THEN HoursCorrected" em="gwt" slice="correct-hours" rule="a submitted month is still open, so it can still be corrected" given="MonthClosureSubmitted" when="CorrectHours" then="HoursCorrected" source="&quot;Can you still book into a month you have already submitted? Yes.&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="2780" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-remove-booking-1" label="an employee can remove their own booking while the month is open&#10;&#10;GIVEN HoursBooked&#10;WHEN RemoveBooking&#10;THEN BookingRemoved" em="gwt" slice="remove-booking" rule="an employee can remove their own booking while the month is open" given="HoursBooked" when="RemoveBooking" then="BookingRemoved" source="&quot;Can a booking be changed or removed afterwards? Yes, by the employees.&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1800" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-remove-booking-2" label="removal is the only way to take a day+project back to nothing&#10;&#10;GIVEN HoursBooked, HoursCorrected&#10;WHEN RemoveBooking&#10;THEN BookingRemoved" em="gwt" slice="remove-booking" rule="removal is the only way to take a day+project back to nothing" given="HoursBooked, HoursCorrected" when="RemoveBooking" then="BookingRemoved" source="&quot;employees may never book 0 hours&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1940" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-remove-booking-3" label="a booking already removed cannot be removed again&#10;&#10;GIVEN BookingRemoved&#10;WHEN RemoveBooking&#10;THEN error: BookingNotFound" em="gwt" slice="remove-booking" rule="a booking already removed cannot be removed again" given="BookingRemoved" when="RemoveBooking" then="error: BookingNotFound" source="accepted by the domain expert — you cannot act on something that is not there">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="2080" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-remove-booking-4" label="a closed month cannot be edited — closed is closed&#10;&#10;GIVEN MonthClosed&#10;WHEN RemoveBooking&#10;THEN error: MonthIsClosed" em="gwt" slice="remove-booking" rule="a closed month cannot be edited — closed is closed" given="MonthClosed" when="RemoveBooking" then="error: MonthIsClosed" source="&quot;Nothing happens much later, closed is closed&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="2220" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-fill-zero-hours-1" label="leaving a project fills the rest of that month with zero hours, one event per day&#10;&#10;GIVEN EmployeeRemovedFromProject&#10;WHEN FillZeroHours&#10;THEN ZeroHoursFilled" em="gwt" slice="fill-zero-hours" rule="leaving a project fills the rest of that month with zero hours, one event per day" given="EmployeeRemovedFromProject" when="FillZeroHours" then="ZeroHoursFilled" source="&quot;we fill out the remainder of the month with 0 hours booked per day&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2340" y="1800" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-fill-zero-hours-2" label="only working days are filled — weekends and public holidays are not&#10;&#10;GIVEN EmployeeRemovedFromProject, WorkingDayPublished&#10;WHEN FillZeroHours&#10;THEN ZeroHoursFilled" em="gwt" slice="fill-zero-hours" rule="only working days are filled — weekends and public holidays are not" given="EmployeeRemovedFromProject, WorkingDayPublished" when="FillZeroHours" then="ZeroHoursFilled" source="&quot;We fill only for working days ... google can provide us a calendar that marks holidays or working saturdays&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2340" y="1940" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-fill-zero-hours-3" label="the system may write a zero where an employee may not&#10;&#10;GIVEN EmployeeRemovedFromProject&#10;WHEN FillZeroHours&#10;THEN ZeroHoursFilled" em="gwt" slice="fill-zero-hours" rule="the system may write a zero where an employee may not" given="EmployeeRemovedFromProject" when="FillZeroHours" then="ZeroHoursFilled" source="&quot;employees may never book 0 hours&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2340" y="2080" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-fill-zero-hours-4" label="a day already zero-filled is not filled twice&#10;&#10;GIVEN ZeroHoursFilled&#10;WHEN FillZeroHours&#10;THEN error: AlreadyFilled" em="gwt" slice="fill-zero-hours" rule="a day already zero-filled is not filled twice" given="ZeroHoursFilled" when="FillZeroHours" then="error: AlreadyFilled" source="accepted by the domain expert — the todo-list tick-off is what stops the processor working a row twice">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2340" y="2220" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-fill-zero-hours-5" label="a day that already carries booked hours is left alone&#10;&#10;GIVEN HoursBooked&#10;WHEN FillZeroHours&#10;THEN error: AlreadyBooked" em="gwt" slice="fill-zero-hours" rule="a day that already carries booked hours is left alone" given="HoursBooked" when="FillZeroHours" then="error: AlreadyBooked" enforce="aggregate" source="domain expert, asked whether a zero may be written over hand-booked hours: &quot;no&quot;. A distinct rule from AlreadyFilled — that one is the processor working a row twice, this one is the automation refusing to overwrite a person's own booking.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2340" y="2360" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-fill-zero-hours-6" label="a closed month is not zero-filled either&#10;&#10;GIVEN MonthClosed&#10;WHEN FillZeroHours&#10;THEN error: MonthIsClosed" em="gwt" slice="fill-zero-hours" rule="a closed month is not zero-filled either" given="MonthClosed" when="FillZeroHours" then="error: MonthIsClosed" enforce="aggregate" source="domain expert, asked whether a closed month blocks a zero-fill: &quot;yes&quot;. The same rule book-hours and correct-hours enforce, so the automation is not privileged here — a closed month is closed to the system too.">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2340" y="2500" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
