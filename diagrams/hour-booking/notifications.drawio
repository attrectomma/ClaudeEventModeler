        </object>
        <object id="gwt-send-closing-reminder-4" label="no second reminder within three days of the last one&#10;&#10;GIVEN ClosingReminderSent&#10;WHEN SendClosingReminder&#10;THEN error: TooSoonToRemind" em="gwt" slice="send-closing-reminder" rule="no second reminder within three days of the last one" given="ClosingReminderSent" when="SendClosingReminder" then="error: TooSoonToRemind" source="&quot;Reminder fire every 3 days&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
