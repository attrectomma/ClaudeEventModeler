          </mxCell>
        </object>
        <object id="gwt-send-closing-reminder-5" label="a closed month is never reminded about&#10;&#10;GIVEN MonthClosed&#10;WHEN SendClosingReminder&#10;THEN error: MonthIsClosed" em="gwt" slice="send-closing-reminder" rule="a closed month is never reminded about" given="MonthClosed" when="SendClosingReminder" then="error: MonthIsClosed" source="&quot;Nothing happens much later, closed is closed&quot;">
