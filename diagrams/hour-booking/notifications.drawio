        </object>
        <object id="gwt-send-closing-reminder-2" label="the reminder repeats every three days while the month stays open&#10;&#10;GIVEN ClosingReminderSent&#10;WHEN SendClosingReminder&#10;THEN ClosingReminderSent" em="gwt" slice="send-closing-reminder" rule="the reminder repeats every three days while the month stays open" given="ClosingReminderSent" when="SendClosingReminder" then="ClosingReminderSent" source="&quot;Reminder fire every 3 days&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1380" y="1615" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-send-closing-reminder-3" label="no reminder before the closing date, which is the last day of the month&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN SendClosingReminder&#10;THEN error: BeforeClosingDate" em="gwt" slice="send-closing-reminder" rule="no reminder before the closing date, which is the last day of the month" given="BookingMonthStarted" when="SendClosingReminder" then="error: BeforeClosingDate" source="&quot;The last day of each month is the closing date&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
