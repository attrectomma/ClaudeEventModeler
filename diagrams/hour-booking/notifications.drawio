        </object>
        <object id="gwt-notify-admins-2" label="every seeded admin is a recipient&#10;&#10;GIVEN MonthClosureSubmitted, AdminSeeded&#10;WHEN NotifyAdmins&#10;THEN AdminsNotified" em="gwt" slice="notify-admins" rule="every seeded admin is a recipient" given="MonthClosureSubmitted, AdminSeeded" when="NotifyAdmins" then="AdminsNotified" source="&quot;All admins can see everything&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="1615" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-notify-admins-3" label="a submission is announced once, not on every pass of the processor&#10;&#10;GIVEN AdminsNotified&#10;WHEN NotifyAdmins&#10;THEN error: AlreadyNotified" em="gwt" slice="notify-admins" rule="a submission is announced once, not on every pass of the processor" given="AdminsNotified" when="NotifyAdmins" then="error: AlreadyNotified" source="accepted by the domain expert — the todo-list tick-off is what stops the processor working a row twice">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="740" y="1755" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-send-closing-reminder-1" label="a month still open after its closing date earns the employee a reminder&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN SendClosingReminder&#10;THEN ClosingReminderSent" em="gwt" slice="send-closing-reminder" rule="a month still open after its closing date earns the employee a reminder" given="BookingMonthStarted" when="SendClosingReminder" then="ClosingReminderSent" source="&quot;For open month of previous month we send a reminder 3 days after the closing date&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
