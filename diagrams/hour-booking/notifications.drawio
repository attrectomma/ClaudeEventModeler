        <object id="gwt-notify-admins-1" label="submitting a closure notifies the admins, and that is recorded as a fact&#10;&#10;GIVEN MonthClosureSubmitted&#10;WHEN NotifyAdmins&#10;THEN AdminsNotified" em="gwt" slice="notify-admins" rule="submitting a closure notifies the admins, and that is recorded as a fact" given="MonthClosureSubmitted" when="NotifyAdmins" then="AdminsNotified" source="&quot;it triggers a notification to the admins&quot; / &quot;I want to record this as a fact&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
