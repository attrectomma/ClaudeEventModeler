        <object id="gwt-book-hours-1" label="hours can be booked on a project the employee belongs to, in an open month&#10;&#10;GIVEN BookingMonthStarted, EmployeeAssignedToProject&#10;WHEN BookHours&#10;THEN HoursBooked" em="gwt" slice="book-hours" rule="hours can be booked on a project the employee belongs to, in an open month" given="BookingMonthStarted, EmployeeAssignedToProject" when="BookHours" then="HoursBooked" source="&quot;employees can book their work hours ... only to project they belong to&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1375" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-2" label="a date in the future is allowed — employees may prefill&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN BookHours&#10;THEN HoursBooked" em="gwt" slice="book-hours" rule="a date in the future is allowed — employees may prefill" given="BookingMonthStarted" when="BookHours" then="HoursBooked" source="&quot;A booking on a future date is allowed, employees may prefill.&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1515" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-3" label="a date in the past is allowed within the open month&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN BookHours&#10;THEN HoursBooked" em="gwt" slice="book-hours" rule="a date in the past is allowed within the open month" given="BookingMonthStarted" when="BookHours" then="HoursBooked" source="&quot;an employee prefers to book all days of the week on Friday. That is acceptable.&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1655" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-4" label="zero hours is not a booking — removal is the only way to take a line back&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN BookHours&#10;THEN error: HoursMustBeNonZero" em="gwt" slice="book-hours" rule="zero hours is not a booking — removal is the only way to take a line back" given="BookingMonthStarted" when="BookHours" then="error: HoursMustBeNonZero" source="&quot;employees may never book 0 hours, so a HoursBooked with 0 hours would be a business rule violation&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1795" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-5" label="hours are booked in whole or half hours only&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN BookHours&#10;THEN error: HoursMustBeWholeOrHalf" em="gwt" slice="book-hours" rule="hours are booked in whole or half hours only" given="BookingMonthStarted" when="BookHours" then="error: HoursMustBeWholeOrHalf" source="&quot;date + project + hours spend. Full hours or 0,5 hours.&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="1935" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-6" label="a closed month cannot be booked into — closed is closed&#10;&#10;GIVEN MonthClosed&#10;WHEN BookHours&#10;THEN error: MonthIsClosed" em="gwt" slice="book-hours" rule="a closed month cannot be booked into — closed is closed" given="MonthClosed" when="BookHours" then="error: MonthIsClosed" source="&quot;Any time until the working month isnt closed&quot; / &quot;closed is closed&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="2075" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-7" label="hours cannot be booked to a project the employee has left, and NOTHING is persisted&#10;&#10;GIVEN EmployeeRemovedFromProject&#10;WHEN BookHours&#10;THEN error: NotAProjectMember" em="gwt" slice="book-hours" rule="hours cannot be booked to a project the employee has left, and NOTHING is persisted" given="EmployeeRemovedFromProject" when="BookHours" then="error: NotAProjectMember" source="&quot;it must be rejected, but we do not persist any new event&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="2215" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-8" label="at most 18 hours can stand for one day&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN BookHours&#10;THEN error: DailyCapExceeded" em="gwt" slice="book-hours" rule="at most 18 hours can stand for one day" given="BookingMonthStarted" when="BookHours" then="error: DailyCapExceeded" source="&quot;Cap is 18 hours&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="2355" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-9" label="a day+project can only be BOOKED once — booking it again is a correction, not a booking&#10;&#10;GIVEN HoursBooked&#10;WHEN BookHours&#10;THEN error: AlreadyBookedUseCorrection" em="gwt" slice="book-hours" rule="a day+project can only be BOOKED once — booking it again is a correction, not a booking" given="HoursBooked" when="BookHours" then="error: AlreadyBookedUseCorrection" source="&quot;There may be only one HoursBooked ... that results in either the one HoursBooked or a Correction&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="2495" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-book-hours-10" label="a submitted month is still open, so it can still be booked into until an admin closes it&#10;&#10;GIVEN MonthClosureSubmitted&#10;WHEN BookHours&#10;THEN HoursBooked" em="gwt" slice="book-hours" rule="a submitted month is still open, so it can still be booked into until an admin closes it" given="MonthClosureSubmitted" when="BookHours" then="HoursBooked" source="&quot;Can you still book into a month you have already submitted? Yes.&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="1700" y="2635" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-1" label="a correction carries the new TOTAL for the day, never the difference&#10;&#10;GIVEN HoursBooked&#10;WHEN CorrectHours&#10;THEN HoursCorrected" em="gwt" slice="correct-hours" rule="a correction carries the new TOTAL for the day, never the difference" given="HoursBooked" when="CorrectHours" then="HoursCorrected" source="&quot;a HoursCorrected event carrying the 8 hours, not the 2 difference!&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2020" y="1375" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-2" label="the truth for a day+project is the last correction, or the booking if there was none&#10;&#10;GIVEN HoursBooked, HoursCorrected&#10;WHEN CorrectHours&#10;THEN HoursCorrected" em="gwt" slice="correct-hours" rule="the truth for a day+project is the last correction, or the booking if there was none" given="HoursBooked, HoursCorrected" when="CorrectHours" then="HoursCorrected" source="&quot;the final truth is last HoursCorrected event if any, or the HoursBooked if no corrections&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2020" y="1515" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-3" label="correcting a day+project that was never booked is not a correction&#10;&#10;GIVEN BookingMonthStarted&#10;WHEN CorrectHours&#10;THEN error: BookingNotFound" em="gwt" slice="correct-hours" rule="correcting a day+project that was never booked is not a correction" given="BookingMonthStarted" when="CorrectHours" then="error: BookingNotFound" source="&quot;There may be only one HoursBooked&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2020" y="1655" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-4" label="a correction cannot take the hours to zero — removal is the only way&#10;&#10;GIVEN HoursBooked&#10;WHEN CorrectHours&#10;THEN error: HoursMustBeNonZero" em="gwt" slice="correct-hours" rule="a correction cannot take the hours to zero — removal is the only way" given="HoursBooked" when="CorrectHours" then="error: HoursMustBeNonZero" source="&quot;employees may never book 0 hours&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2020" y="1795" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-5" label="corrections are in whole or half hours only&#10;&#10;GIVEN HoursBooked&#10;WHEN CorrectHours&#10;THEN error: HoursMustBeWholeOrHalf" em="gwt" slice="correct-hours" rule="corrections are in whole or half hours only" given="HoursBooked" when="CorrectHours" then="error: HoursMustBeWholeOrHalf" source="&quot;Full hours or 0,5 hours&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2020" y="1935" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-6" label="a correction cannot push the day over 18 hours&#10;&#10;GIVEN HoursBooked&#10;WHEN CorrectHours&#10;THEN error: DailyCapExceeded" em="gwt" slice="correct-hours" rule="a correction cannot push the day over 18 hours" given="HoursBooked" when="CorrectHours" then="error: DailyCapExceeded" source="&quot;Cap is 18 hours&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2020" y="2075" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-7" label="a closed month cannot be corrected — closed is closed&#10;&#10;GIVEN MonthClosed&#10;WHEN CorrectHours&#10;THEN error: MonthIsClosed" em="gwt" slice="correct-hours" rule="a closed month cannot be corrected — closed is closed" given="MonthClosed" when="CorrectHours" then="error: MonthIsClosed" source="&quot;Any time until the working month isnt closed&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2020" y="2215" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-correct-hours-8" label="a submitted month is still open, so it can still be corrected&#10;&#10;GIVEN MonthClosureSubmitted&#10;WHEN CorrectHours&#10;THEN HoursCorrected" em="gwt" slice="correct-hours" rule="a submitted month is still open, so it can still be corrected" given="MonthClosureSubmitted" when="CorrectHours" then="HoursCorrected" source="&quot;Can you still book into a month you have already submitted? Yes.&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2020" y="2355" width="300" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="gwt-remove-booking-1" label="an employee can remove their own booking while the month is open&#10;&#10;GIVEN HoursBooked&#10;WHEN RemoveBooking&#10;THEN BookingRemoved" em="gwt" slice="remove-booking" rule="an employee can remove their own booking while the month is open" given="HoursBooked" when="RemoveBooking" then="BookingRemoved" source="&quot;Can a booking be changed or removed afterwards? Yes, by the employees.&quot;">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
            <mxGeometry x="2340" y="1375" width="300" height="120" as="geometry" />
