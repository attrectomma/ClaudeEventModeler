        </mxCell>
        <object id="cmd-place-order" label="PlaceOrder" em="command" slice="place-order" aggregate="Order" fields="orderId:Guid, customerId:Guid, totalAmount:decimal, currency:string" rejects="EmptyOrder: totalAmount &lt;= 0" examples="EmptyOrder: totalAmount=0">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
